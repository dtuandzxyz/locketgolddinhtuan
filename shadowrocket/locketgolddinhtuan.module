#!name=Locket Gold by Dinh Tuan Hakaiz
#!desc=Mở khóa gói Locket Gold vĩnh viễn & tự động bắt Token API Locket Camera
#!author=Dinh Tuan Hakaiz
#!category=LocketGold

[Script]
# Mở khóa Locket Gold qua RevenueCat
LocketGold = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/dinhtuanhakaiz/locketgolddinhtuan/main/shadowrocket/locket_gold.js

# Bắt token Locket tự động
LocketToken = type=http-request,pattern=^https:\/\/api\.locketcamera\.com\/.+,requires-body=0,script-path=https://raw.githubusercontent.com/dinhtuanhakaiz/locketgolddinhtuan/main/shadowrocket/locket_token.js

[MITM]
hostname = %APPEND% api.revenuecat.com, api.locketcamera.com
